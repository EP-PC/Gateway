# Copie para .env (não versionado) e preencha.
# Use os MESMOS valores do .env do Auth-service: o volume store_db-data é compartilhado
# e o admin do seed já existe com o hash que foi usado na primeira vez.

# Chave HMAC do JWT (usada pelo auth): Base64 de 32 bytes ALEATÓRIOS.
#   openssl rand -base64 32
#   PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET_KEY=

# Seed do primeiro ADMIN (usado pelo account). Hash = Base64(SHA-256(senha)):
#   printf '%s' 'suaSenha' | openssl dgst -sha256 -binary | base64
ACCOUNT_ADMIN_EMAIL=
ACCOUNT_ADMIN_HASH=

# Opcionais
# JWT_DURATION=3600000
# JWT_HTTP_ONLY=true
# CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
